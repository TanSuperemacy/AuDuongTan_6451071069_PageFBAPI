PORT=3001

# ── Facebook Graph API ────────────────────────────────────────────────────────
# Lấy từ Meta Developer App > Tools > Graph API Explorer
PAGE_ACCESS_TOKEN=EAAXgpgQpX6UBRQIm4RmogINMLgZCOJFQiWMZAXUx6VCESktyZCh2tZB9lGLMvMvNVsKn3UertuNTwG290uSVpZBSHkBz41iZCZBbmWzDj0LBuZApGF5ZB6tRBxmzlKvI6y3aLLmnjNllnqVYrCeIDjL07b8qJXFqOD6l4nvA9ZCFwEnnuID0zwDk08cxeYt9dIFb8MAlgFTW2jWVNGxe0eaxKDzVehv43dDLhyLNhkWpNpb0QZD

# Version của Graph API (nên dùng v19.0 trở lên)
GRAPH_API_VERSION=v19.0

# ── Facebook Webhook ──────────────────────────────────────────────────────────
# Token tự đặt, phải khớp với giá trị bạn nhập trên Meta Developer Dashboard
WEBHOOK_VERIFY_TOKEN=my_secure_verify_token_2024

# App Secret — lấy từ Meta Developer App > Settings > Basic > App Secret
# Dùng để xác thực chữ ký X-Hub-Signature-256 của mỗi request từ Facebook
FACEBOOK_APP_SECRET=206392b01ea7be8a5afe0e017722d6c3

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Địa chỉ Kafka broker (nếu dùng Docker Compose bên dưới thì giữ nguyên)
KAFKA_BROKERS=localhost:9092

# Client ID gửi lên Kafka (tên tùy chọn, dùng để nhận diện producer)
KAFKA_CLIENT_ID=facebook-page-api

# Tên topic nhận sự kiện thô từ Webhook
KAFKA_TOPIC=raw_events

# Consumer group ID cho Core Service
KAFKA_CONSUMER_GROUP_ID=core-service

# ── AI / Gemini ───────────────────────────────────────────────────────────────
# API Key của Google Gemini (nếu không có → dùng rule-based mock)
# Lấy từ https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
