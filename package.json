{
  "name": "facebook-page-api",
  "version": "2.0.0",
  "description": "Backend API wrapper cho Facebook Page Graph API + Webhook & Kafka real-time processing",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "start:backend": "node services/backend-api/src/index.js",
    "start:core": "node services/core-service/src/index.js",
    "start:retry": "node services/retry-service/src/index.js",
    "start:all": "concurrently \"npm run start\" \"npm run start:backend\" \"npm run start:core\" \"npm run start:retry\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
